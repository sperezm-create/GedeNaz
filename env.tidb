# Configuracion para PROBAR TiDB Cloud Starter en paralelo (no reemplaza .env).
# Se usa asi:   GEDENAZ_ENV_FILE=.env.tidb pytest
# Este archivo esta en .gitignore: no se sube a GitHub.
#
# Completa los valores con lo que te muestra TiDB Cloud en
# tu cluster > Connect (boton arriba a la derecha). No los pegues en el chat.
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=2PEgdxYKi7moG9w.root
DB_PASSWORD=H7oewrosTLVUVGpS
# "test" es la base que trae TiDB por defecto. Usarla evita tener que crear otra.
DB_NAME=test
# TiDB Cloud exige TLS. Si el panel te ofrece descargar un certificado CA,
# guardalo en secrets/ y pon aqui su ruta (ej. secrets/tidb-ca.pem).
# Si el panel dice que no hace falta, dejalo vacio y avisame.
DB_SSL_CA=secrets/tidb-ca.pem
