# Copiar este archivo a ".env" (no versionado) y completar con credenciales locales de MySQL.
#
# Si tu MySQL vive en Aiven (ver docs/specs/05-entorno-desarrollo.md,
# seccion 8), los valores tienen esta forma en vez de las de abajo:
#   DB_HOST=<algo>.aivencloud.com
#   DB_PORT=<puerto que te da Aiven, no es el 3306 por defecto>
#   DB_USER=avnadmin
#   DB_NAME=defaultdb   (o el nombre que le hayas puesto a tu base)
#   DB_SSL_CA=ruta/al/ca.pem   (Aiven exige SSL; certificado descargable desde su Console)
DB_HOST=localhost
DB_PORT=3306
DB_USER=gedenaz_app
DB_PASSWORD=
DB_NAME=gedenaz
DB_SSL_CA=
