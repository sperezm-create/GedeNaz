# Copiar este archivo a ".env" (no versionado) y completar con credenciales locales de MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=gedenaz_app
DB_PASSWORD=
DB_NAME=gedenaz
DB_SSL_CA=

# Credenciales requeridas para proteger la API; usa valores propios en .env.
API_ADMIN_USERNAME=
API_ADMIN_PASSWORD=
