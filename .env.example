# Copiar este archivo a ".env" (no versionado) y completar.

# --- Base de datos ---
# MySQL local:
DB_HOST=localhost
DB_PORT=3306
DB_USER=gedenaz_app
DB_PASSWORD=
DB_NAME=gedenaz
DB_SSL_CA=
# TiDB Cloud (lo mismo que ya usas en databaseconnect/env.tidb):
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_USER=<prefijo>.root
#   DB_PASSWORD=<clave>
#   DB_NAME=gedenaz_final        # base NUEVA, no la de databaseconnect (ver guia)
#   DB_SSL_CA=secrets/tidb-ca.pem   # relativa a la raiz del proyecto, o ruta absoluta
# Opcionales:
# DB_TIMEZONE=America/Santiago
# DB_SSL_VERIFY_IDENTITY=false

# Para usar otro archivo en vez de .env (ej. el env.tidb de databaseconnect):
#   GEDENAZ_ENV_FILE=env.tidb

# --- Credenciales para proteger la API (usa valores propios) ---
API_ADMIN_USERNAME=
API_ADMIN_PASSWORD=
