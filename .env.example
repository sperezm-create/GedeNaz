# Copiar este archivo a ".env" (no versionado) y completar con credenciales locales de MySQL.
#
# Si tu MySQL vive en PythonAnywhere (ver docs/specs/05-entorno-desarrollo.md,
# seccion 8), los valores tienen esta forma en vez de las de abajo:
#   DB_HOST=<tu_usuario>.mysql.pythonanywhere-services.com
#   DB_USER=<tu_usuario>
#   DB_NAME=<tu_usuario>$gedenaz   (el $ es parte del nombre, no un placeholder)
DB_HOST=localhost
DB_PORT=3306
DB_USER=gedenaz_app
DB_PASSWORD=
DB_NAME=gedenaz
